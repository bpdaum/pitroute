generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String   @unique
  url       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    Event[]
}

model Event {
  id              String       @id @default(uuid())
  organizationId  String
  name            String
  date            DateTime
  locationAddress String?
  latitude        Float?
  longitude       Float?
  purseAmount     Float?
  detailsUrl      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  cookPlans       CookPlan[]
  organization    Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name, date])
  @@index([organizationId])
  @@index([date])
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String?     @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  accounts      Account[]
  cookPlans     CookPlan[]
  packages      Package[]
  savedTrips    SavedTrip[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SavedTrip {
  id         String   @id @default(cuid())
  userId     String
  title      String?
  routeData  Json
  totalPurse Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CookPlan {
  id                 String   @id @default(cuid())
  userId             String
  eventId            String
  meatType           String
  turnInTime         String?
  ingredients        String?
  recipe             String?
  timeline           String?
  postNotes          String?
  aiFeedback         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  brinePackageId     String?
  cookTimeNotes      String?
  injectionPackageId String?
  rank               Int?
  saucePackageId     String?
  score              Float?
  seasoningPackageId String?
  brinePackage       Package? @relation("BrinePackage", fields: [brinePackageId], references: [id])
  event              Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  injectionPackage   Package? @relation("InjectionPackage", fields: [injectionPackageId], references: [id])
  saucePackage       Package? @relation("SaucePackage", fields: [saucePackageId], references: [id])
  seasoningPackage   Package? @relation("SeasoningPackage", fields: [seasoningPackageId], references: [id])
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId, meatType])
}

model Package {
  id           String     @id @default(cuid())
  userId       String?
  isPublic     Boolean    @default(false)
  name         String
  packageType  String
  ingredients  String?
  instructions String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  brines       CookPlan[] @relation("BrinePackage")
  injections   CookPlan[] @relation("InjectionPackage")
  sauces       CookPlan[] @relation("SaucePackage")
  seasonings   CookPlan[] @relation("SeasoningPackage")
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
