// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String   @unique // e.g., "KCBS", "MBN"
  url       String?
  events    Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  name            String
  date            DateTime
  locationAddress String?
  latitude        Float?
  longitude       Float?
  purseAmount     Float?
  detailsUrl      String? // Link to specific event page
  cookPlans       CookPlan[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, name, date])
  @@index([organizationId])
  @@index([date])
}

// NextAuth Required Models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  savedTrips    SavedTrip[]
  cookPlans     CookPlan[]
  packages      Package[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Custom App Models
model SavedTrip {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String? // Optional user-provided name for the trip
  routeData   Json // Stores the full TripResult JSON payload
  totalPurse  Float // Stored separately for easy querying/sorting
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model CookPlan {
  id          String   @id @default(cuid())
  userId      String
  eventId     String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  meatType    String   // e.g. "Brisket", "Ribs", "Pork", "Chicken"
  turnInTime  String?  // Time the meat is due to judges
  ingredients String?  
  recipe      String?  
  
  timeline    String?  // JSON string storing the AI generated schedule
  
  postNotes   String?  
  aiFeedback  String?  // AI's expert advice
  
  injectionPackageId String?
  injectionPackage   Package? @relation("InjectionPackage", fields: [injectionPackageId], references: [id], onDelete: SetNull)
  brinePackageId     String?
  brinePackage       Package? @relation("BrinePackage", fields: [brinePackageId], references: [id], onDelete: SetNull)
  seasoningPackageId String?
  seasoningPackage   Package? @relation("SeasoningPackage", fields: [seasoningPackageId], references: [id], onDelete: SetNull)
  saucePackageId     String?
  saucePackage       Package? @relation("SaucePackage", fields: [saucePackageId], references: [id], onDelete: SetNull)
  
  cookTimeNotes      String?  @db.Text
  score              Float?
  rank               Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([userId, eventId, meatType])
}

model Package {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  packageType  String      // "INJECTION", "SEASONING", "BRINE", "SAUCE", "OTHER"
  ingredients  String?     @db.Text
  instructions String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  // Relations to CookPlan
  injections   CookPlan[]  @relation("InjectionPackage")
  brines       CookPlan[]  @relation("BrinePackage")
  seasonings   CookPlan[]  @relation("SeasoningPackage")
  sauces       CookPlan[]  @relation("SaucePackage")

  @@index([userId])
}
